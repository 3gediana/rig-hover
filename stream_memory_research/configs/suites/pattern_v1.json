{
  "name": "pattern_v1",
  "round": "R3",
  "description": "核心实验（ROUND 3）：时序模式判别。判别信息只在'脉冲串'的时间结构里（个数/顺序/间隔），最后一拍对齐、幅度重置，因此单帧分类器已被验证为 chance。这类任务需要多时间常数的带通积分，grud 单一齐次时间常数 + 按帧数推进；DSM 的多尺度衰减 Λ=[8,2,0.5,0.02]/s 天然是节律匹配滤波器组。机制消融：n_decay_groups=1（单时间常数）与 decay=False（无时间衰减）必须掉点，否则优势不是来自多时间常数。",
  "seeds": [0, 1, 2],
  "defaults": {
    "loss": {"aux_num_scale": 0.1},
    "train": {
      "epochs": 50, "batch": 64, "lr": 0.003, "wd": 0.0001, "amp": true,
      "grad_clip": 1.0, "patience": 40, "aug": "none", "tok_fusion": "flatten",
      "T_max": 64, "val_every": 1, "warmup_epochs": 3,
      "num_workers": 0, "preload": true, "preload_max_gb": 6.0
    },
    "eval": {"robustness": ["dense", "stride2", "stride4", "drop50", "burst", "repeat", "jitter", "shuffled", "mixed"]}
  },
  "datasets": {
    "synth_pattern_count": {
      "task": "synth",
      "manifest": "data_manifests/synth_pattern_count.json",
      "heads": {"class": {"kind": "ce", "dim": 16, "n_classes": 16, "ignore": -1}},
      "main_metric": "acc",
      "loss": {"task": {"class": 1.0}},
      "train": {"epochs": 50}
    },
    "synth_pattern_order": {
      "task": "synth",
      "manifest": "data_manifests/synth_pattern_order.json",
      "heads": {"class": {"kind": "ce", "dim": 16, "n_classes": 16, "ignore": -1}},
      "main_metric": "acc",
      "loss": {"task": {"class": 1.0}},
      "train": {"epochs": 50}
    },
    "synth_pattern_rate": {
      "task": "synth",
      "manifest": "data_manifests/synth_pattern_rate.json",
      "heads": {"class": {"kind": "ce", "dim": 16, "n_classes": 16, "ignore": -1}},
      "main_metric": "acc",
      "loss": {"task": {"class": 1.0}},
      "train": {"epochs": 50}
    },
    "synth_pattern_count_irregular": {
      "task": "synth",
      "manifest": "data_manifests/synth_pattern_count_irregular.json",
      "heads": {"class": {"kind": "ce", "dim": 16, "n_classes": 16, "ignore": -1}},
      "main_metric": "acc",
      "loss": {"task": {"class": 1.0}},
      "train": {"epochs": 50}
    }
  },
  "models": [
    {"name": "mlp", "hidden": 192, "variant": "base", "notes": "无时序整合（下界）"},
    {"name": "gru", "hidden": 192, "variant": "base", "notes": "单时间常数、按帧数推进（主对手）"},
    {"name": "lstm", "hidden": 192, "variant": "base"},
    {"name": "cfc", "hidden": 192, "variant": "base", "cfg": {"backbone_units": 64}, "notes": "用户原基线"},
    {"name": "mamba", "hidden": 192, "variant": "base"},
    {"name": "deltanet", "hidden": 192, "variant": "base", "cfg": {"mem_dim": 64}, "notes": "只有快记忆、无慢状态"},
    {"name": "dsm", "hidden": 192, "variant": "base", "cfg": {"mem_dim": 64}, "notes": "完整模型：多尺度衰减 + delta 快记忆"},
    {"name": "dsm", "hidden": 192, "variant": "nogroups", "cfg": {"mem_dim": 64, "n_decay_groups": 1}, "notes": "机制消融：单一时间常数"},
    {"name": "dsm", "hidden": 192, "variant": "nodecay", "cfg": {"mem_dim": 64, "decay": false}, "notes": "机制消融：无时间衰减（退化为无物理时间的快权）"},
    {"name": "dsm_slot", "hidden": 192, "variant": "base", "cfg": {"n_slots": 12, "slot_dim": 64}, "notes": "槽位快记忆变体"}
  ]
}
