{
  "name": "davis_v1b",
  "round": "R5",
  "description": "真实视频任务 3/4：DAVIS 遮挡恢复（bbox 回归）。主指标 mae（全部帧），但科学指标是 per_gap：按『距该目标上次被观测的秒数』分桶的 bbox 误差。ROI 可见帧是平凡可解的；遮挡由 lab_age 标记。",
  "seeds": [
    0,
    1,
    2
  ],
  "defaults": {
    "loss": {
      "aux_num_scale": 0.0
    },
    "train": {
      "epochs": 60,
      "batch": 32,
      "lr": 0.002,
      "wd": 0.0001,
      "amp": true,
      "grad_clip": 1.0,
      "patience": 12,
      "aug": "none",
      "tok_fusion": "none",
      "T_max": 48,
      "val_every": 1,
      "warmup_epochs": 3,
      "num_workers": 0,
      "preload": true,
      "preload_max_gb": 2.0
    },
    "eval": {
      "robustness": [
        "dense",
        "stride2",
        "drop50",
        "burst",
        "repeat",
        "jitter",
        "shuffled",
        "mixed"
      ]
    }
  },
  "datasets": {
    "davis_vos3": {
      "task": "track",
      "manifest": "data_manifests/davis_vos3.json",
      "heads": {
        "track": {
          "kind": "mse",
          "dim": 4
        }
      },
      "main_metric": "mae",
      "loss": {
        "task": {
          "track": 1.0
        },
        "aux_num_scale": 0.0
      },
      "train": {
        "epochs": 60
      }
    }
  },
  "models": [
    {
      "name": "mlp",
      "hidden": 192,
      "variant": "base",
      "notes": "无记忆下界（遮挡段必然失败）"
    },
    {
      "name": "gru",
      "hidden": 192,
      "variant": "base"
    },
    {
      "name": "lstm",
      "hidden": 192,
      "variant": "base"
    },
    {
      "name": "cfc",
      "hidden": 192,
      "variant": "base",
      "cfg": {
        "backbone_units": 64
      }
    },
    {
      "name": "mamba",
      "hidden": 192,
      "variant": "base"
    },
    {
      "name": "deltanet",
      "hidden": 192,
      "variant": "base",
      "cfg": {
        "mem_dim": 64
      }
    },
    {
      "name": "dsm",
      "hidden": 192,
      "variant": "base",
      "cfg": {
        "mem_dim": 64
      }
    },
    {
      "name": "dsm",
      "hidden": 192,
      "variant": "nd",
      "cfg": {
        "mem_dim": 64,
        "decay": false
      }
    },
    {
      "name": "dsm_slot",
      "hidden": 192,
      "variant": "base",
      "cfg": {
        "n_slots": 8,
        "slot_dim": 64
      }
    }
  ]
}