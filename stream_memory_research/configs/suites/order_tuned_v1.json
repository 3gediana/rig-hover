{
  "name": "order_tuned_v1",
  "round": "R6",
  "description": "ROUND 6b：把在 pattern_rate 上找到的稳定化配置（mem_dim 256 + 无衰减 + lr 1e-3 + warmup 6）用到真实视频时序方向判别上，看能否进一步拉开与 GRU 的差距。3 seeds。",
  "seeds": [0, 1, 2],
  "defaults": {
    "loss": {"aux_num_scale": 0.0},
    "train": {
      "epochs": 15, "batch": 32, "lr": 0.001, "wd": 0.0001, "amp": true,
      "grad_clip": 1.0, "patience": 5, "aug": "none", "tok_fusion": "none",
      "T_max": 48, "val_every": 1, "warmup_epochs": 6,
      "num_workers": 0, "preload": true, "preload_max_gb": 2.0
    },
    "eval": {"robustness": ["dense", "stride2", "drop50", "burst", "mixed"]}
  },
  "datasets": {
    "ucf101_order": {
      "task": "action",
      "manifest": "data_manifests/ucf101_order.json",
      "heads": {"order": {"kind": "ce", "dim": 2, "n_classes": 2, "ignore": -1}},
      "main_metric": "acc",
      "loss": {"task": {"order": 1.0}, "aux_num_scale": 0.0},
      "train": {"epochs": 15}
    }
  },
  "models": [
    {"name": "dsm", "hidden": 192, "variant": "nd256_lr1e3",
     "cfg": {"mem_dim": 256, "decay": false},
     "notes": "R6 稳定化配置：mem256 + 无衰减 + lr1e-3 + warmup6"},
    {"name": "dsm", "hidden": 192, "variant": "nd256_lr1e3_g4",
     "cfg": {"mem_dim": 256, "n_decay_groups": 4},
     "notes": "mem256 + 保留多时间常数 + lr1e-3"}
  ]
}
