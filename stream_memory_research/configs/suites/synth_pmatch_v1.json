{
  "name": "synth_pmatch_v1",
  "round": "R1",
  "description": "参数量匹配的合成任务对比（每个模型 hidden 由 build_core_matched 调到 ~150k 参数）。用于回答「优势是否只是参数更多」。",
  "seeds": [
    0
  ],
  "defaults": {
    "loss": {
      "task": {
        "state": 1.0,
        "class": 1.0,
        "event": 1.0
      },
      "aux_num_scale": 0.1
    },
    "train": {
      "epochs": 50,
      "batch": 64,
      "lr": 0.003,
      "wd": 0.0001,
      "amp": true,
      "grad_clip": 1.0,
      "patience": 40,
      "aug": "none",
      "T_max": 96,
      "val_every": 1,
      "warmup_epochs": 3,
      "num_workers": 0,
      "preload": true,
      "preload_max_gb": 6.0,
      "tok_fusion": "flatten"
    },
    "eval": {
      "robustness": [
        "dense",
        "stride2",
        "stride4",
        "drop50",
        "burst",
        "repeat",
        "jitter",
        "shuffled",
        "mixed"
      ]
    }
  },
  "datasets": {
