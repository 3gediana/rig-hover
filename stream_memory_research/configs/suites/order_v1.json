{
  "name": "order_v1",
  "round": "R3",
  "description": "真实视频时序方向判别（arrow-of-time / temporal order verification）。同一段 UCF101 视频产生两个样本：原始帧序 vs 倒放帧序；两类的帧集合完全相同、只有顺序不同。任何忽略时序的模型（逐帧 / 池化 / 只看当前帧）在此任务上被构造性地钉在 50%。这是一个标准的时序理解任务，且与『敲两下 vs 敲一下』同源：判别信息只存在于时间轴上的演变方向。",
  "seeds": [0, 1],
  "defaults": {
    "loss": {"aux_num_scale": 0.0},
    "train": {
      "epochs": 15, "batch": 32, "lr": 0.002, "wd": 0.0001, "amp": true,
      "grad_clip": 1.0, "patience": 5, "aug": "none", "tok_fusion": "none",
      "T_max": 48, "val_every": 1, "warmup_epochs": 2,
      "num_workers": 0, "preload": true, "preload_max_gb": 4.0
    },
    "eval": {"robustness": ["dense", "stride2", "drop50", "burst", "mixed"]}
  },
  "datasets": {
    "ucf101_order": {
      "task": "action",
      "manifest": "data_manifests/ucf101_order.json",
      "heads": {"order": {"kind": "ce", "dim": 2, "n_classes": 2, "ignore": -1}},
      "main_metric": "acc",
      "loss": {"task": {"order": 1.0}, "aux_num_scale": 0.0},
      "train": {"epochs": 15}
    }
  },
  "models": [
    {"name": "mlp", "hidden": 192, "variant": "base", "notes": "每帧 MLP（应≈50%）"},
    {"name": "gru", "hidden": 192, "variant": "base"},
    {"name": "lstm", "hidden": 192, "variant": "base"},
    {"name": "cfc", "hidden": 192, "variant": "base", "cfg": {"backbone_units": 64}},
    {"name": "mamba", "hidden": 192, "variant": "base"},
    {"name": "deltanet", "hidden": 192, "variant": "base", "cfg": {"mem_dim": 64}},
    {"name": "dsm", "hidden": 192, "variant": "base", "cfg": {"mem_dim": 64}},
    {"name": "dsm", "hidden": 192, "variant": "nogroups", "cfg": {"mem_dim": 64, "n_decay_groups": 1}},
    {"name": "dsm_slot", "hidden": 192, "variant": "base", "cfg": {"n_slots": 12, "slot_dim": 64}}
  ]
}
