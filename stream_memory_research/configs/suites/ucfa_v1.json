{
  "name": "ucfa_v1",
  "round": "R5",
  "description": "真实视频任务 4/4：UCF101 在线动作识别（101 类）。维度 E（因果在线能力）。注意逐帧 CLIP 特征本身很强：MLP 无记忆下界已达 test acc 0.7516，所以绝对准确率不是记忆证据，要靠 prefix 曲线形状与鲁棒性。主指标 acc。",
  "seeds": [0, 1],
  "defaults": {
    "loss": {"aux_num_scale": 0.0},
    "train": {
      "epochs": 12, "batch": 64, "lr": 0.002, "wd": 0.0001, "amp": true,
      "grad_clip": 1.0, "patience": 4, "aug": "medium", "tok_fusion": "none",
      "T_max": 96, "val_every": 1, "warmup_epochs": 1,
      "num_workers": 0, "preload": true, "preload_max_gb": 2.5
    },
    "eval": {"robustness": ["dense", "stride2", "stride4", "drop50", "burst", "shuffled"]}
  },
  "datasets": {
    "ucf101_action_feat": {
      "task": "action",
      "manifest": "data_manifests/ucf101_action_feat.json",
      "heads": {"action": {"kind": "ce", "dim": 101, "n_classes": 101, "ignore": -1}},
      "main_metric": "acc",
      "loss": {"task": {"action": 1.0}, "aux_num_scale": 0.0},
      "train": {"epochs": 12}
    }
  },
  "models": [
    {"name": "mlp", "hidden": 192, "variant": "base", "notes": "无记忆下界（已实测 0.7516）"},
    {"name": "gru", "hidden": 192, "variant": "base"},
    {"name": "lstm", "hidden": 192, "variant": "base"},
    {"name": "cfc", "hidden": 192, "variant": "base", "cfg": {"backbone_units": 64}},
    {"name": "mamba", "hidden": 192, "variant": "base"},
    {"name": "deltanet", "hidden": 192, "variant": "base", "cfg": {"mem_dim": 64}},
    {"name": "dsm", "hidden": 192, "variant": "base", "cfg": {"mem_dim": 64}},
    {"name": "dsm_slot", "hidden": 192, "variant": "base", "cfg": {"n_slots": 12, "slot_dim": 64}}
  ]
}
