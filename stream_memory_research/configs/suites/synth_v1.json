{
  "name": "synth_v1",
  "round": "R1",
  "description": "受控合成记忆任务主对比：8 个时序核心 × 6 个任务 × 3 seeds。所有模型同一 head、同一种子、同一预算。",
  "seeds": [
    0,
    1,
    2
  ],
  "defaults": {
    "loss": {
      "task": {
        "state": 1.0,
        "class": 1.0,
        "event": 1.0
      },
      "aux_num_scale": 0.1
    },
    "train": {
      "epochs": 50,
      "batch": 64,
      "lr": 0.003,
      "wd": 0.0001,
      "amp": true,
      "grad_clip": 1.0,
      "patience": 40,
      "aug": "none",
      "T_max": 96,
      "val_every": 1,
      "warmup_epochs": 3,
      "num_workers": 0,
      "preload": true,
      "preload_max_gb": 6.0,
      "tok_fusion": "flatten"
    },
    "eval": {
      "robustness": [
        "dense",
        "stride2",
        "stride4",
        "drop50",
        "burst",
        "repeat",
        "jitter",
        "shuffled",
        "mixed"
      ]
    }
  },
  "datasets": {
    "synth_recall_single": {
      "task": "synth",
      "manifest": "data_manifests/synth_recall_single.json",
      "heads": {
        "state": {
          "kind": "mse",
          "dim": 256
        }
      },
      "main_metric": "cos",
      "loss": {
        "task": {
          "state": 1.0
        }
      },
      "train": {
        "epochs": 50
      }
    },
    "synth_recall_multi": {
      "task": "synth",
      "manifest": "data_manifests/synth_recall_multi.json",
      "heads": {
        "state": {
          "kind": "mse",
          "dim": 256
        }
      },
      "main_metric": "cos",
      "loss": {
        "task": {
          "state": 1.0
        }
      },
      "train": {
        "epochs": 50
      }
    },
    "synth_vanish_reappear": {
      "task": "synth",
      "manifest": "data_manifests/synth_vanish_reappear.json",
      "heads": {
        "class": {
          "kind": "ce",
          "dim": 16,
          "ignore": -1
        }
      },
      "main_metric": "acc",
      "loss": {
        "task": {
          "class": 1.0
        }
      },
      "train": {
        "epochs": 50
      }
    },
    "synth_change_detect": {
      "task": "synth",
      "manifest": "data_manifests/synth_change_detect.json",
      "heads": {
        "state": {
          "kind": "mse",
          "dim": 256
        }
      },
      "main_metric": "cos",
      "loss": {
        "task": {
          "state": 1.0
        }
      },
      "train": {
        "epochs": 50
      }
    },
    "synth_event_seq": {
      "task": "synth",
      "manifest": "data_manifests/synth_event_seq.json",
      "heads": {
        "event": {
          "kind": "bce",
          "dim": 1
        },
        "state": {
          "kind": "mse",
          "dim": 256
        }
      },
      "main_metric": "cos",
      "loss": {
        "task": {
          "event": 1.0,
          "state": 1.0
        }
      },
      "train": {
        "epochs": 50
      }
    },
    "synth_irregular": {
      "task": "synth",
      "manifest": "data_manifests/synth_irregular_recall_multi_logdt.json",
      "heads": {
        "state": {
          "kind": "mse",
          "dim": 256
        }
      },
      "main_metric": "cos",
      "loss": {
        "task": {
          "state": 1.0
        }
      },
      "train": {
        "epochs": 50
      }
    },
    "synth_irregular_drop50": {
      "task": "synth",
      "manifest": "data_manifests/synth_irregular_recall_multi_drop50.json",
      "heads": {
        "state": {
          "kind": "mse",
          "dim": 256
        }
      },
      "main_metric": "cos",
      "loss": {
        "task": {
          "state": 1.0
        }
      },
      "train": {
        "epochs": 50
      }
    }
  },
  "models": [
    {
      "name": "mlp",
      "hidden": 192,
      "variant": "base"
    },
    {
      "name": "gru",
      "hidden": 192,
      "variant": "base"
    },
    {
      "name": "lstm",
      "hidden": 192,
      "variant": "base"
    },
    {
      "name": "cfc",
      "hidden": 192,
      "variant": "base",
      "cfg": {
        "backbone_units": 64
      }
    },
    {
      "name": "mamba",
      "hidden": 192,
      "variant": "base"
    },
    {
      "name": "mamba",
      "hidden": 192,
      "variant": "tdt",
      "cfg": {
        "tdt": true
      }
    },
    {
      "name": "deltanet",
      "hidden": 192,
      "variant": "base",
      "cfg": {
        "mem_dim": 64
      }
    },
    {
      "name": "dsm",
      "hidden": 192,
      "variant": "base",
      "cfg": {
        "mem_dim": 64,
        "n_decay_groups": 4
      }
    },
    {
      "name": "dsm",
      "hidden": 192,
      "variant": "nodt",
      "cfg": {
        "mem_dim": 64,
        "use_dt_struct": false,
        "use_dt_feature": false
      }
    },
    {
      "name": "dsm_slot",
      "hidden": 192,
      "variant": "base",
      "cfg": {
        "n_slots": 12,
        "slot_dim": 64
      }
    }
  ]
}