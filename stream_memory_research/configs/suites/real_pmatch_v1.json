{
  "name": "real_pmatch_v1",
  "round": "R1",
  "description": "占位：真实视频数据集使用 d_in=768 的参数量匹配 hidden 表（数据集条目后续替换）。",
  "seeds": [
    0,
    1,
    2
  ],
  "defaults": {
    "loss": {
      "task": {
        "state": 1.0,
        "class": 1.0,
        "event": 1.0
      },
      "aux_num_scale": 0.1
    },
    "train": {
      "epochs": 40,
      "batch": 64,
      "lr": 0.003,
      "wd": 0.0001,
      "amp": true,
      "grad_clip": 1.0,
      "patience": 8,
      "aug": "none",
      "T_max": 128,
      "val_every": 1,
      "warmup_epochs": 3,
      "num_workers": 0,
      "preload": true,
      "preload_max_gb": 6.0,
      "tok_fusion": "none"
    },
    "eval": {
      "robustness": [
        "dense",
        "stride2",
        "stride4",
        "drop50",
        "burst",
        "repeat",
        "jitter",
        "shuffled",
        "mixed"
      ]
    }
  },
  "datasets": {
    "synth_recall_single": {
      "task": "synth",
      "manifest": "data_manifests/synth_recall_single.json",
      "heads": {
        "state": {
          "kind": "mse",
          "dim": 256
        }
      },
      "main_metric": "r2",
      "loss": {
