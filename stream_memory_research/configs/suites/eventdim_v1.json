{
  "name": "eventdim_v1",
  "round": "R9",
  "description": "ROUND 9：补测维度 C（事件理解）与维度 D（不规则采样）。主扫在跑到 vanish_reappear 后被打断，event_seq 与 irregular 系列从未真正跑过。event_seq 的判别是：稀疏事件（敲击脉冲）发生后，目标状态必须在长时间内保持——这正是用户场景。主指标 cos（事件后状态召回），次指标事件 F1。",
  "seeds": [
    0,
    1,
    2
  ],
  "defaults": {
    "loss": {
      "aux_num_scale": 0.1
    },
    "train": {
      "epochs": 50,
      "batch": 64,
      "lr": 0.003,
      "wd": 0.0001,
      "amp": true,
      "grad_clip": 1.0,
      "patience": 40,
      "aug": "none",
      "tok_fusion": "flatten",
      "T_max": 96,
      "val_every": 1,
      "warmup_epochs": 3,
      "num_workers": 0,
      "preload": true,
      "preload_max_gb": 6.0
    },
    "eval": {
      "robustness": [
        "dense",
        "stride2",
        "stride4",
        "drop50",
        "burst",
        "repeat",
        "jitter",
        "shuffled",
        "mixed"
      ]
    }
  },
  "datasets": {
    "synth_event_seq": {
      "task": "synth",
      "manifest": "data_manifests/synth_event_seq.json",
      "heads": {
        "event": {
          "kind": "bce",
          "dim": 1,
          "n_classes": 1
        },
        "state": {
          "kind": "mse",
          "dim": 256
        }
      },
      "main_metric": "cos",
      "loss": {
        "task": {
          "event": 1.0,
          "state": 1.0
        }
      },
      "train": {
        "epochs": 50
      }
    }
  },
  "models": [
    {
      "name": "mlp",
      "hidden": 192,
      "variant": "base",
      "notes": "无记忆下界"
    },
    {
      "name": "gru",
      "hidden": 192,
      "variant": "base"
    },
    {
      "name": "lstm",
      "hidden": 192,
      "variant": "base"
    },
    {
      "name": "cfc",
      "hidden": 192,
      "variant": "base",
      "cfg": {
        "backbone_units": 64
      }
    },
    {
      "name": "mamba",
      "hidden": 192,
      "variant": "base"
    },
    {
      "name": "deltanet",
      "hidden": 192,
      "variant": "base",
      "cfg": {
        "mem_dim": 64
      }
    },
    {
      "name": "dsm",
      "hidden": 192,
      "variant": "base",
      "cfg": {
        "mem_dim": 64
      }
    },
    {
      "name": "dsm_slot",
      "hidden": 192,
      "variant": "base",
      "cfg": {
        "n_slots": 12,
        "slot_dim": 64
      }
    },
    {
      "name": "dual",
      "hidden": 128,
      "variant": "lin",
      "cfg": {
        "mem_dim": 64,
        "fusion": "linear"
      },
      "notes": "重设计核心"
    }
  ]
}