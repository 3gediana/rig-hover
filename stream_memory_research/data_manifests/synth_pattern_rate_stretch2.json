    "nominal_dt": 0.1,
    "layout": {
      "layout_version": 1,
      "KMAX": 16,
      "V": 16,
      "VC": 8,
      "VA": 8,
      "N_CODES": 16,
      "tok_dim": 17,
      "feat_dim": 64,
      "feat_summary_dim": 16,
      "C_EVENT": 4
    },
    "channel_layout": {
      "feat": {
        "shape": "[T, 64] float16",
        "summary_channels": [
          {
            "idx": 0,
            "name": "bias",
            "meaning": "constant 1.0"
          },
          {
            "idx": 1,
            "name": "vis_frac",
            "meaning": "number of currently observed object tokens / 16"
          },
          {
            "idx": 2,
            "name": "any_hidden",
            "meaning": "1.0 if at least one existing object is currently hidden"
          },
          {
            "idx": 3,
            "name": "query",
            "meaning": "1.0 on steps flagged as a recall query"
          },
          {
            "idx": 4,
            "name": "event_pulse",
            "meaning": "1.0 on an event step (knock/wave impulse)"
          },
          {
            "idx": 5,
            "name": "event_type_norm",
            "meaning": "event type / (C_EVENT-1) in [0,1]; 0 when no event"
          },
          {
            "idx": 6,
            "name": "elapsed_s_60",
            "meaning": "physical elapsed time / 60 s (causal clock)"
          },
          {
            "idx": 7,
            "name": "event_age_s_60",
            "meaning": "seconds since the last event / 60 s (0 if none yet)"
          },
          {
            "idx": 8,
            "name": "since_change_s_60",
            "meaning": "seconds since any visible token value last changed / 60 s"
          },
          {
            "idx": 9,
            "name": "hidden_asked_frac",
            "meaning": "number of object-slots that are existing+hidden / 16"
          },
          {
            "idx": 10,
            "name": "mean_vis_norm",
            "meaning": "mean L2 norm of the currently observed token values"
          },
          {
            "idx": 11,
            "name": "n_existing_frac",
            "meaning": "number of existing object slots / 16"
          },
          {
            "idx": 12,
            "name": "reserved",
            "meaning": "0.0"
          },
          {
            "idx": 13,
            "name": "reserved",
            "meaning": "0.0"
          },
          {
            "idx": 14,
            "name": "reserved",
            "meaning": "0.0"
          },
          {
            "idx": 15,
            "name": "reserved",
            "meaning": "0.0"
          }
        ],
        "reserved": "channels 16..63 are always 0.0 (reserved)"
      },
      "tok": {
        "shape": "[T, 16, 17] float16",
        "channels_0_15": "that object's current 16-dim value (identity dims zeroed when visible-but-not-identifiable)",
        "channel_16": "visibility flag: 1.0 iff the object is observed now; when not observed the entire token is 0"
      },
      "labels": {
        "lab_state": "[T, 256] float32 = 16 slots x 16 state dims; true state scaled by lab_mask-independent knowability (0 where the slot is unused or its value is unknowable)",
        "lab_mask": "[T, 16] float32 = 1.0 iff the slot is asked for (knowable but absent from the current observation); all metrics are computed on lab_mask==1",
        "lab_class": "[T] int64 = -1 ignore; identity id (vanish_reappear) or event type (event_seq)",
        "lab_event": "[T] float32 0/1 event indicator"
      },
      "identity_code": "state dims 0..7: signed one-hot (16 identities); dims 8..15: N(0,1) analogue"
    },
    "phases": {
      "history": 0,
      "scored": 1
    },
    "main_metric": "acc",
    "task_params": {
      "n_classes": 2,
      "anchor_s": 1.7,
      "anchor_jitter_s": 0.1,
      "tail_s": 0.9,
