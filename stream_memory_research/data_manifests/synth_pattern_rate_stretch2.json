    "task_id": "pattern_rate",
    "seed_base": 20261103,
    "split_policy": "split by episode generator seed group: train=[0,800), val=[800,1000), test=[1000,1200); source_id = 'ep<index>' (never split by frame); test episodes are generated independently",
    "split_ranges": {
      "train": [
        0,
