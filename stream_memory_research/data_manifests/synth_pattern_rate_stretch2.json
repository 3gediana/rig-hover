    "control": null,
    "eval_manifests": [],
    "eval_manifest_paths": [],
    "notes": "eval-only physics-time stretch x2; same episodes as synth_pattern_rate, only the clock is scaled",
    "oracle_reference_definition": {
      "perfect": "unbounded faithful memory reading only the observation (PerfectMemoryOracle) -> sanity upper bound 1.0",
      "memoryless": "outputs the current observation only (ZeroMemoryOracle) -> memoryless bound",
      "chance": "random read-out (RandomOracle) -> theoretical chance"
    },
    "pattern_family": true,
    "n_classes": 2,
    "chance_level_acc": 0.5,
    "pattern_kind": "rate",
    "stretch": 2.0,
    "pattern_channel_layout": {
      "family": "pattern_*",
      "rule": "no single frame is sufficient; the class is a property of the whole pulse train; the last target pulse is time-aligned across classes so every non-memory channel is class-independent at the scored steps",
      "feat": {
        "shape": "[T, 64] float16 (same tensor shape as all synth datasets)",
        "0": "bias = 1.0",
        "1": "0.0 (unused in this family)",
        "2": "0.0 (unused)",
        "3": "query = 1.0 on scored steps (evidence complete)",
        "4": "target pulse = 1.0 at target-event frames",
        "5": "event type = 0.0 (A) / 1.0 (B) at target pulses (pattern_order)",
        "6": "elapsed physical time / 60 s",
        "7": "seconds since the last NOISE event / 60 s",
        "8": "0.0 (unused)",
        "9": "background amplitude (smooth, class-independent)",
        "10": "amplitude envelope (decay from the most recent target pulse)",
        "11": "noise-event pulse = 1.0 (distractor, never changes the class)",
        "12-15": "0.0 (unused; no finite-difference channels, they would give an exploitable tail on near-duplicate timestamps)"
      },
      "tok": {
        "slot0": "[amplitude, background, target_pulse, noise_pulse, event_type, 0 x 11], visibility flag = 1.0 (always observed)",
        "slots1..15": "zero (unused)"
      },
      "labels": {
        "lab_state": "slot0 dims 0..7 = one-hot class; dims 8..15 = (n_pulses/3, span_s, last_type_marker, 0...)",
        "lab_mask": "1.0 on slot 0 at scored steps only",
        "lab_class": "class id at scored steps, -1 elsewhere (main metric acc)",
        "lab_event": "1.0 at target pulse frames",
        "lab_age": "slot0 = physical seconds since the last target pulse",
        "lab_gap_s": "pattern span (last - first pulse), physical seconds"
      },
      "meta_pattern": "[1,4] float: (n_classes, kind_id, stretch, is_irregular)",
      "kinds": {
        "0": "count",
        "1": "order",
        "2": "rate",
        "3": "mixed"
      }
    },
    "balanced_classes": true
  },
