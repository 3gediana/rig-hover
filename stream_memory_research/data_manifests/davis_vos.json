{
  "dataset": "davis_vos",
  "task": "track",
  "feature_dim": 768,
  "tok_dim": 768,
  "roi_dim": 768,
  "n_roi": 1,
  "encoder": {
    "name": "openai/clip-vit-base-patch16",
    "tag": "clip-vit-base-p16-224-f16-2x2tok-v1",
    "input": 224,
    "pool": "2x2",
    "n_tok": 4,
    "dtype": "float16",
    "frozen": true,
    "preprocess": "CLIPImageProcessor",
    "roi_preprocess": "crop mask-bbox + 10% margin, stretch 224"
  },
  "split_key": "source_id",
  "label_specs": {
    "lab_track": {
      "kind": "mse",
      "dim": 4
    },
    "lab_present": {
      "kind": "bce",
      "n_classes": 1,
      "dim": 1
    }
  },
  "extra": {
    "sampling": "10 fps target: frame indices round(k * 24/10) over the native image sequence, cap 120",
    "timestamp_rule": "t = frame_index / 24 (DAVIS 2017 release is 24 fps; no per-sequence fps field exists in the archive)",
    "split": "official DAVIS 2017 ImageSets/2017 train (60) / val (30), split by sequence, never by frame",
    "roi": "mask bbox of the annotated object, normalised (cx,cy,w,h)",
    "roi_valid": "0 where the mask is empty OR inside a simulated occlusion gap (see occlusion_simulation)",
    "labels": {
      "lab_track": "[T,1,4] normalised bbox of the object at frame t -- supervised even while roi_valid=0 (memory target)",
      "lab_present": "[T,1] 1 if the object mask is non-empty (true visibility, not the injected flag)"
    },
    "occlusion_simulation": {
      "why": "DAVIS is a VOS benchmark: the annotated object is present in essentially every frame, so the literal 'mask empty' rule produces no invalid frames and cannot test memory.",
      "how": "per sequence, 1-3 gaps of 0.4-1.5 s (seeded by (seed, seq), deterministic), total <= 40% of frames, never frame 0, separated by >= 1 s of valid data",
      "what_is_real": "pixels, CLIP features, mask bboxes, lab_present",
      "what_is_injected": "only the roi_valid flag",
      "seed": 0
    },
    "source_urls": [
      "https://huggingface.co/datasets/yinloonga/DAVIS_2017 (DAVIS-2017-trainval-480p.zip, 832,766,765 B, contains JPEGImages/480p + Annotations/480p for all 90 sequence)",
      "official https://data.vision.ee.ethz.ch/csergi/share/davis/DAVIS-2017-trainval-480p.zip measured at 0.04 MB/s -> not used"
    ],
    "encoder_config": {
      "model": "openai/clip-vit-base-patch16",
      "input_size": 224,
      "dtype": "float16",
      "device": "cuda"
    },
    "seed": 0,
    "deterministic": true,
    "n_extracted": 90,
    "skipped": {}
  },
