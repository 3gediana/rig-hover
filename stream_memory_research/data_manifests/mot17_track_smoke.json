  "extra": {
    "selection_rule": "One detector family (FRCNN) to avoid triplicating scenes; split by sequence: train={02,04,09}, val={05}, test={10,11}.",
    "sampling": "5 fps: original frame indices 1,1+step,... with step=round(fps/5) (fps=30 -> step 6); no cap",
    "timestamp_rule": "t = (original_1based_frame - 1) / seqinfo fps (real physical time, dt=0.2 s)",
    "label_semantics": {
      "lab_track": "[T,N,4] normalised (cx,cy,w,h) of the anchor's NEXT OBSERVED box (absolute box, not a delta). Defined even while roi_valid=0 -> that is the occlusion recovery target.",
      "lab_id": "[T,N] contiguous anchor id == slot index; -1 where the anchor is invalid. Anchor slots are FIXED per sequence so the same pedestrian always occupies the same slot; meta.id_map maps slot -> original MOT id.",
      "roi_valid": "0 when conf!=1, class!=1, visibility<=0, box degenerate, or the box overlaps an ignore region (class 2/7/8/12, IoU>0.5)."
    },
    "anchor_selection": "the 8 pedestrian ids valid in the most frames (cls==1, conf==1, visibility>0, w,h>1), ties broken by ascending original id; final slot order sorted by original id",
    "source_urls": [
      "https://motchallenge.net/data/MOT17.zip (5.86 GB, direct, no login)",
      "HF mirrors Lekim89/MOT17 and Morrison1025/MOT17 exist but ship images only (no gt.txt) -> not usable for tracking labels"
    ],
    "source_note": "MOT17 test split has no public GT; the 'test' here is a held-out set of train-set sequences, split by sequence exactly as required.",
